# Copy to .env and fill in. Everything here is read by docker-compose.yml (containers)
# and by scripts/autoscale.sh (host). Inline comments are fine, the scaler sources it.

RUNNER_SCOPE=org                 # org | repo (repo also needs GH_REPO)
GH_OWNER=your-org
GH_APP_ID=000000                 # GitHub App with org permission "Self-hosted runners: read & write"
GH_APP_PRIVATE_KEY_B64=          # macOS/OrbStack only: base64 of the .pem instead of the bind mount
GH_APP_KEY_PATH=./secrets/app-key.pem   # host path; required by scripts/autoscale.sh
# GH_TOKEN=                      # PAT fallback if you have no App (App is preferred)

RUNNER_GROUP=default
RUNNER_NAME_PREFIX=runner        # PREFIX only — the container id is appended, never pin full names
RUNNER_LABELS=self-hosted,Linux,ARM64,docker

RUNNER_MIN=8                     # idle floor
RUNNER_MAX=20                    # ceiling
RUNNER_HEADROOM=4                # spare idle runners kept warm
RUNNER_REPLICAS=4                # cold-start count for `docker compose up -d`

RUNNER_CPUS=4
RUNNER_MEMORY=8g
RUNNER_EPHEMERAL=true
RUNNER_ENABLE_DIND=true
DISK_TARGET_GB=40                # reserved; no script reads it today

# autoscaler safety knobs (defaults shown; see scripts/autoscale.sh)
# RUNNER_IDLE_MIN_AGE=90         # a listener younger than this is never removed
# RUNNER_STOP_GRACE=120          # seconds a runner gets to leave after SIGTERM
# RUNNER_SCALE_DOWN_COOLDOWN=300 # no scale-down this soon after a scale-up
# RUNNER_SCALE_DOWN_MAX=2        # removals per tick
